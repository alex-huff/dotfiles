#!/bin/python3

import json
import os
import subprocess

from PIL import Image

def generate_background(
    background_name, background_width, background_height, background_color,
    border_color=(40, 40, 40), border_width=2
):
    bg = Image.new(
        "RGB",
        size=(background_width, background_height),
        color=background_color,
    )
    match border_width:
        case tuple():
            top_border, bottom_border, left_border, right_border = border_width
        case int():
            top_border = bottom_border = left_border = right_border = border_width
        case _:
            assert False
    rects = {
        (0, background_width, 0, top_border),
        (0, background_width, background_height - bottom_border, background_height),
        (0, left_border, 0, background_height),
        (background_width - right_border, background_width, 0, background_height),
    }
    for start_x, end_x, start_y, end_y in rects:
        if start_x == end_x or start_y == end_y:
            continue
        for x in range(start_x, end_x):
            for y in range(start_y, end_y):
                bg.putpixel((x, y), border_color)
    bg.save(os.path.expanduser(f"~/.assets/{background_name}_background.png"))


current_display_information = json.loads(
    subprocess.check_output(
        "swaymsg -t get_outputs | jq '.[] | first(select(.active == true)) | .current_mode'",
        shell=True,
    )
)
display_width = current_display_information["width"]
display_height = current_display_information["height"]

background_color = (249, 245, 215)
darker_background_color = (251, 241, 199)

app_switcher_vertical_margin = display_height // 6
app_switcher_height = display_height - app_switcher_vertical_margin * 2
app_switcher_width = round(app_switcher_height * 0.8)
app_switcher_right_margin = 26
app_switcher_left_margin = display_width - (app_switcher_width + app_switcher_right_margin)

kitty_overlay_vertical_margin = app_switcher_vertical_margin
kitty_overlay_height = app_switcher_height
kitty_overlay_approximate_width = kitty_overlay_height * 2
kitty_overlay_horizontal_margin = (
    display_width - kitty_overlay_approximate_width
) // 2
kitty_overlay_width = display_width - kitty_overlay_horizontal_margin * 2

small_kitty_overlay_vertical_margin = display_height // 3
small_kitty_overlay_height = display_height - small_kitty_overlay_vertical_margin * 2
small_kitty_overlay_approximate_width = small_kitty_overlay_height * 2
small_kitty_overlay_horizontal_margin = (
    display_width - small_kitty_overlay_approximate_width
) // 2
small_kitty_overlay_width = display_width - small_kitty_overlay_horizontal_margin * 2

bar_width = display_width
bar_height = 28

generate_background(
    "app_switcher",
    app_switcher_width,
    app_switcher_height,
    darker_background_color,
)
generate_background(
    "kitty_overlay",
    kitty_overlay_width,
    kitty_overlay_height,
    background_color,
)
generate_background(
    "kitty_overlay_darker",
    kitty_overlay_width,
    kitty_overlay_height,
    darker_background_color,
)
generate_background(
    "small_kitty_overlay",
    small_kitty_overlay_width,
    small_kitty_overlay_height,
    background_color,
)
generate_background(
    "small_kitty_overlay_darker",
    small_kitty_overlay_width,
    small_kitty_overlay_height,
    darker_background_color,
)
generate_background(
    "bar",
    bar_width,
    bar_height,
    darker_background_color,
)
