#!/bin/sh

if [ -n "$KITTY_OVERLAY_DIMENSIONS" ]
then
    IFS=":" read lines columns <<-EOF
		$KITTY_OVERLAY_DIMENSIONS
	EOF
    sizing_args=$(
		cat <<-EOF
			--edge=center-sized
			--lines=$lines
			--columns=$columns
		EOF
    )
else
    if [ "$LARGE_KITTY_OVERLAY" = "true" -o "$LARGE_KITTY_OVERLAY" = "1" ]
    then
        vertical_margin_ratio=6
        approximate_aspect_ratio=2
    else
        vertical_margin_ratio=3
        approximate_aspect_ratio=2
    fi
    eval "$(swaymsg -t get_outputs | jq -r '.[] | first(select(.active == true)) | .current_mode | "width=\(.width); height=\(.height)"')"
    vertical_margin=$(($height/$vertical_margin_ratio))
    panel_height=$(($height-$vertical_margin*2))
    approximate_panel_width=$(($panel_height*$approximate_aspect_ratio))
    horizontal_margin=$((($width-$approximate_panel_width)/2))
    sizing_args=$(
		cat <<-EOF
			--edge=center
			--margin-top=$vertical_margin
			--margin-bot=$vertical_margin
			--margin-left=$horizontal_margin
			--margin-right=$horizontal_margin
		EOF
    )
fi

kitten panel \
    --single-instance \
    --instance-group=kitty-overlay \
    --layer=overlay \
    --focus-policy=exclusive \
    $sizing_args \
    --override=window_padding_width=8 \
    --override="custom_shaders ~/.config/kitty/shaders/border" \
    --override=background="#fbf1c7" \
    "$@"
