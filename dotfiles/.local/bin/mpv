#!/bin/sh

exec /bin/mpv \
    --ao=pulse \
    --hwdec=yes \
    --af=scaletempo2=max-speed=10 \
    --video-reversal-buffer=4GiB \
    --input-ipc-server="${XDG_RUNTIME_DIR}/mpv-ipc-$$.sock" \
    --script-opts=osc-boxalpha=0,osc-fadeduration=0,context_menu-corner_radius=0 \
    --subs-fallback=yes \
    --sub-font="Libron R" \
    --sub-scale=0.6 \
    --keep-open=yes \
    --force-window=immediate \
    "$@"
