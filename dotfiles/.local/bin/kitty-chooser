#!/bin/python3

import asyncio
from asyncio.streams import StreamReader, StreamWriter
import os
import shlex
import sys
import tempfile


async def connect_reader_to_loop(read_file):
    loop = asyncio.get_running_loop()

    reader = asyncio.StreamReader()
    read_protocol = asyncio.StreamReaderProtocol(reader)
    await loop.connect_read_pipe(lambda: read_protocol, read_file)

    return reader


async def connect_writer_to_loop(write_file, reader=None):
    loop = asyncio.get_running_loop()

    write_transport, write_protocol = await loop.connect_write_pipe(
        asyncio.streams.FlowControlMixin, write_file)
    writer = asyncio.StreamWriter(write_transport, write_protocol, reader, loop)

    return writer


async def forward_data(reader, writer):
    if type(reader) is not StreamReader:
        reader = await connect_reader_to_loop(reader)
    if type(writer) is not StreamWriter:
        writer = await connect_writer_to_loop(writer, reader=reader)

    while len(bytes_read := await reader.read(n=2**10)):
        writer.write(bytes_read)
        await writer.drain()

    writer.close()


async def main(temp_dir):
    loop = asyncio.get_running_loop()

    input_fifo_name = os.path.join(temp_dir, "input")
    output_fifo_name = os.path.join(temp_dir, "output")
    exit_code_fifo_name = os.path.join(temp_dir, "exit_code")
    for fifo_name in (input_fifo_name, output_fifo_name, exit_code_fifo_name):
        os.mkfifo(fifo_name)

    kitty_process = await asyncio.subprocess.create_subprocess_exec(
        "kitty-overlay",
        "sh", "-c",
        f'fzf "$@" < {shlex.quote(input_fifo_name)} > {shlex.quote(output_fifo_name)}; echo -E "$?" > {shlex.quote(exit_code_fifo_name)}',
        *sys.argv,
        stdin=asyncio.subprocess.DEVNULL,
        stdout=asyncio.subprocess.DEVNULL,
        stderr=asyncio.subprocess.DEVNULL)

    input_fifo_file = open(input_fifo_name, "w")
    output_fifo_file = open(output_fifo_name, "r")

    # You can only attach certain files like pipes, sockets, and other
    # transports to an asyncio event loop (epoll limitation). Rather than
    # writing seperate code paths for when stdin or stdout isn't one of the
    # supported file types, launch a cat process to read/write from
    # stdin/stdout directly and proxy all data through it. Is this insane?
    # Doing blocking reads on the event loop is not an option since the user
    # may select and item in fzf while we are still blocked on a read and we
    # want to exit as soon as the user selects an item. As always, I now
    # realize that using threads would have been easier than asyncio.
    stdin_cat_proxy = await asyncio.subprocess.create_subprocess_exec(
        "cat",
        stdin=None,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.DEVNULL)
    stdout_cat_proxy = await asyncio.subprocess.create_subprocess_exec(
        "cat",
        stdin=asyncio.subprocess.PIPE,
        stdout=None,
        stderr=asyncio.subprocess.DEVNULL)
    stdin_pipe = stdin_cat_proxy.stdout
    stdout_pipe = stdout_cat_proxy.stdin

    forward_stdin_task = loop.create_task(forward_data(stdin_pipe, input_fifo_file))
    await forward_data(output_fifo_file, stdout_pipe)

    exit_code_fifo_file = open(exit_code_fifo_name, "r")
    exit_code_reader = await connect_reader_to_loop(exit_code_fifo_file)
    exit_code_bytes = await exit_code_reader.read(n=-1)
    exit_code_string = exit_code_bytes.decode("utf-8")

    return int(exit_code_string)


with tempfile.TemporaryDirectory(prefix="kitty-chooser", ignore_cleanup_errors=True) as temp_dir:
    try:
        sys.exit(asyncio.run(main(temp_dir)))
    except KeyboardInterrupt:
        ...
