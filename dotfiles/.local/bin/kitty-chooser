async def main(temp_dir):
    loop = asyncio.get_running_loop()

    input_fifo_name = os.path.join(temp_dir, "input")
    output_fifo_name = os.path.join(temp_dir, "output")
    for fifo_name in (input_fifo_name, output_fifo_name):
        os.mkfifo(fifo_name)

    kitty_process = await asyncio.subprocess.create_subprocess_exec(
        "kitty-overlay", "sh", "-c", f"fzf --multi < {input_fifo_name} > {output_fifo_name}",
        stdin=asyncio.subprocess.DEVNULL,
        stdout=asyncio.subprocess.DEVNULL,
        stderr=asyncio.subprocess.DEVNULL)

    input_fifo_file = open(input_fifo_name, "w")
    output_fifo_file = open(output_fifo_name, "r")

    forward_stdin_task = loop.create_task(forward_data(sys.stdin, input_fifo_file))
    await forward_data(output_fifo_file, sys.stdout)

with tempfile.TemporaryDirectory(prefix="kitty-chooser", ignore_cleanup_errors=True) as temp_dir:
    try:
        asyncio.run(main(temp_dir))
    except KeyboardInterrupt:
        ...
