#!/bin/python3

import asyncio
import os
import sys
import tempfile

async def connect_reader_and_writer_to_loop(read_file, write_file):
    loop = asyncio.get_running_loop()

    reader = asyncio.StreamReader()
    read_protocol = asyncio.StreamReaderProtocol(reader)
    await loop.connect_read_pipe(lambda: read_protocol, read_file)

    write_transport, write_protocol = await loop.connect_write_pipe(
        asyncio.streams.FlowControlMixin, write_file)
    writer = asyncio.StreamWriter(write_transport, write_protocol, reader, loop)

    return reader, writer

async def forward_data(read_file, write_file):
    reader, writer = await connect_reader_and_writer_to_loop(
        read_file, write_file)

    while len(bytes_read := await reader.read(n=2**10)):
        writer.write(bytes_read)
        await writer.drain()

    writer.close()

